{
  "name": "dsh-perm-gate",
  "version": "0.2.1-beta.3",
  "description": "DSH permission-gate: a single self-sufficient, deterministic-first, fail-closed gate covering P0 hard-deny -> P1 session grant -> P2 static rule (allow/deny) chain -> P3 optional LLM semantic classifier -> P4 ask, with command whitelist/blacklist.",
  "type": "module",
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets",
    "examples",
    "README.md",
    "README.zh.md",
    "README.ja.md",
    "README.ko.md",
    "INSTALL.md",
    "INSTALL.zh.md",
    "INSTALL.ja.md",
    "INSTALL.ko.md",
    "CHANGELOG.md",
    "CHANGELOG.ja.md",
    "CHANGELOG.ko.md",
    "LICENSE"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./engine": {
      "types": "./lib/engine.d.ts",
      "default": "./lib/engine.js"
    },
    "./shell": {
      "types": "./lib/shell.d.ts",
      "default": "./lib/shell.js"
    },
    "./grant": {
      "types": "./lib/grant.d.ts",
      "default": "./lib/grant.js"
    },
    "./classifier": {
      "types": "./lib/classifier.d.ts",
      "default": "./lib/classifier.js"
    },
    "./allowlist": {
      "types": "./lib/allowlist.d.ts",
      "default": "./lib/allowlist.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-perm-gate": "./lib/cli.js"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.1.2-alpha.1 <0.2.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.5-rc.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "eslint": "^10.9.1",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^3.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsdown",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint src test scripts tsdown.config.ts eslint.config.mjs",
    "test": "vitest run",
    "verify:line": "node scripts/verify-line.mjs new",
    "verify:lines": "node scripts/verify-line.mjs both",
    "release:latest": "npm publish --tag latest",
    "release:legacy": "npm publish --tag legacy"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "permission",
    "permission-gate",
    "allowlist",
    "denylist",
    "sandbox",
    "permissive",
    "approval",
    "ai-safety"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  }
}
